# Data Plane Worker: Restate Handlers for PDM Oracle ack
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        libaio1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY pyproject.toml .
RUN mkdir dag_tools && touch dag_tools/__init__.py && touch README.md
RUN uv venv .venv && \
    uv pip install '.[worker]'

RUN rm -rf dag_tools README.md
COPY . /dag-tools
RUN uv pip install -e /dag-tools

COPY examples/pdm_oracle_ingestion/restate_entrypoint.py /app/restate_entrypoint.py

EXPOSE 9080
CMD ["python", "restate_entrypoint.py"]
