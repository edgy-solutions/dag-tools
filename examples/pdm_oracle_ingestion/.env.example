# Oracle source + ack target (used by Dagster + tests on host)
ORACLE_DSN_URL=oracle+oracledb://pdm:pdm@localhost:1525/?service_name=FREEPDB1
PDM_ORACLE_HOST=localhost
PDM_ORACLE_PORT=1525
PDM_ORACLE_SERVICE=FREEPDB1
PDM_ORACLE_USER=pdm
PDM_ORACLE_PASSWORD=pdm

# Used by the worker container (matches docker-compose service network names)
ORACLE_DSN=oracle:1521/FREEPDB1
ORACLE_USER=pdm
ORACLE_PASSWORD=pdm

# Postgres is only used as dlt's destination for the ingested rows; the ack
# itself goes back to Oracle via the GenericOracleAckService.
POSTGRES_DSN=postgresql://admin:password@localhost:5433/pdm_local
DESTINATION__POSTGRES__CREDENTIALS=postgresql://admin:password@localhost:5433/pdm_local

# Restate ingress (host-side; container-side is http://restate:8080)
RESTATE_INGRESS_URL=http://localhost:8087
RESTATE_ADMIN_URL=http://localhost:9077

# The MEI list, supplied as a git-repo overlay. Read at materialization
# time, so re-pointing this path takes effect on the next run rather than
# the next redeploy.
PDM_MEI_OVERLAY_PATH=./mei_overlay/meis.yaml
