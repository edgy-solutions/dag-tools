# Shared Restate worker image.
#
# Hosts every handler in dag_tools.restate_handlers behind one generic,
# env-driven entrypoint. Consumers select which services to run with the
# RESTATE_SERVICES env var and never build their own image.
#
#   docker run \
#     -e RESTATE_SERVICES=oracle_ack \
#     -e RESTATE_ADMIN_URL=http://restate:9070 \
#     -e RESTATE_ADVERTISED_URI=http://restate-worker:9080 \
#     -e ORACLE_DSN=... -e ORACLE_USER=... -e ORACLE_PASSWORD=... \
#     ghcr.io/edgy-solutions/dag-tools/restate-worker:latest
FROM python:3.11-slim-bookworm

# System deps for the data-plane handlers:
#   libaio1     — Oracle (oracledb) — used by oracle_ack
#   msodbcsql18 — SQL Server (pyodbc) — used by api_sync to ack back to MSSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg2 unixodbc-dev libaio1 \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --batch --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install dependencies first (cached layer). Dummy package metadata lets uv
# resolve the [worker] extras without the full source tree.
COPY pyproject.toml README.md ./
RUN mkdir dag_tools && touch dag_tools/__init__.py
RUN uv venv .venv && uv pip install '.[worker]'

# Install the real package.
RUN rm -rf dag_tools
COPY dag_tools/ ./dag_tools/
RUN uv pip install -e .

EXPOSE 9080
CMD ["python", "-m", "dag_tools.restate_handlers.serve"]
